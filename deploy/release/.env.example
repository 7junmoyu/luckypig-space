# Private runtime configuration; never include a populated copy in a release packet.
TARGET_PLATFORM=linux/amd64
COMPOSE_PROJECT_NAME=luckypig-release
SITE_ID=luckypig
CONTENT_SOURCE=halo
SPACE_IMAGE=luckypig-space-web:0.3.0-amd64
POSTGRES_IMAGE=postgres:17.11
HALO_IMAGE=halohub/halo:2.27.2
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
WEB_PORT=4183
HALO_PORT=8190
# For a local isolated trial; set actual HTTPS origins before public deployment.
PUBLIC_URL=http://127.0.0.1:4183
HALO_EXTERNAL_URL=http://127.0.0.1:8190
CHAT_MODE=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
