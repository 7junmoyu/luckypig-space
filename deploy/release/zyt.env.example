# Copy to private .env.zyt; do not reuse the original site's private config.
TARGET_PLATFORM=linux/amd64
COMPOSE_PROJECT_NAME=zyt-release
SITE_ID=zyt
# Curated profile/projects are included in the NEW image. Dedicated Halo is initially empty.
CONTENT_SOURCE=portfolio
# Rebuild shared code first. The 2026-11-11 image does not include ZYT support.
SPACE_IMAGE=REPLACE_WITH_NEW_SHARED_IMAGE_TAG
POSTGRES_IMAGE=postgres:17.11
HALO_IMAGE=halohub/halo:2.27.2
POSTGRES_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
WEB_PORT=4184
HALO_PORT=8191
PUBLIC_URL=http://127.0.0.1:4184
HALO_EXTERNAL_URL=http://127.0.0.1:8191
CHAT_MODE=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
