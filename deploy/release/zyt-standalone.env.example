# Private deployment config. Set API/model/keys through /admin after startup.
COMPOSE_PROJECT_NAME=zyt-space
TARGET_PLATFORM=linux/amd64
SPACE_IMAGE=zyt-space-web:source-v1-amd64
NODE_IMAGE=node:24-bookworm-slim
WEB_PORT=4184
WEB_BIND=127.0.0.1
# Use your actual HTTPS root origin for public access, e.g. https://zyt.your-domain.tld
# The default below is for localhost or an SSH-forwarded preview only.
PUBLIC_URL=http://127.0.0.1:4184
