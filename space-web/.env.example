# demo: explicit reference content; halo: published content, no demo fallback.
CONTENT_SOURCE=halo
HALO_URL=http://127.0.0.1:8090
HALO_PROJECT_CATEGORY=space-project
HALO_PROFILE_SLUG=space-profile
HOST=127.0.0.1
PORT=4173
# Canonical visitor URL used by MCP, Skill and citation links.
PUBLIC_URL=http://127.0.0.1:4173

# Server only. Never place this key in public/ or commit your .env.
CHAT_MODE=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
LLM_TIMEOUT_MS=60000

# Optional generic key; takes precedence over DEEPSEEK_API_KEY before UI configuration.
# CHAT_MODE=openai-compatible is supported for compatible Chat Completions services.
LLM_API_KEY=
# Optional web search. These are independent of the LLM credentials.
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
# Once saved via /admin, .local/model-settings.json takes precedence over these LLM/search defaults.
